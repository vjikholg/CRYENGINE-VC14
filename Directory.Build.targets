<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(CryRuntimeProject)' == 'true' And '$(Platform)' == 'x64'">
    <OutDir>$(MSBuildThisFileDirectory)CrysisWars\Bin64\</OutDir>
    <OutDir Condition="'$(CryPteRuntimeDir)' != ''">$(CryPteRuntimeDir)\</OutDir>
    <TargetPath Condition="'$(CryPteRuntimeDir)' != ''">$(OutDir)$(TargetName)$(TargetExt)</TargetPath>
    <IntDir>$(MSBuildThisFileDirectory)CrysisWars\BinTemp\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(CryRuntimeProject)' == 'true' And '$(Platform)' == 'x64'">
    <ClCompile>
      <MinimalRebuild>false</MinimalRebuild>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
